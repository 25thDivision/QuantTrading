KIS_PAPER_KEY=
KIS_PAPER_SECRET=
KIS_REAL_KEY=      # k12 전용 — 랩실 .env에는 채우지 않는다
KIS_REAL_SECRET=   # k12 전용 — 랩실 .env에는 채우지 않는다

# 디스코드 웹훅 — 채널 4분할 (config notify.discord.webhooks 와 대응). 미설정 채널은 경고 로그만 남기고 생략
DISCORD_WEBHOOK_COLLECTOR=   # 수집 일상 요약 (성공·실패 무관 매일)
DISCORD_WEBHOOK_PAPER=       # 모의·페이퍼 (Phase 4~5, 지금은 자리만)
DISCORD_WEBHOOK_LIVE=        # 실전 (Phase 6~, 지금은 자리만)
DISCORD_WEBHOOK_ALERTS=      # 경고·긴급 (수집 부분 실패·캐시 폴백·중단. 훗날 안전장치 발동·크래시)
