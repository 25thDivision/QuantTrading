# QuantTrading 분봉 스윕 수집기 (결정 11) — k12 전용 oneshot 서비스. collector.timer 가 매일 기동한다.
# 배포: scripts/deploy_units.sh 로 /etc/systemd/system/ 에 복사 → daemon-reload (심볼릭 링크 금지 — 결정 8)
[Unit]
Description=QuantTrading minute-candle sweep collector (decision 11)
After=network-online.target
Wants=network-online.target
# on-failure 재시작이 무한 반복되지 않도록 1시간에 3회로 제한 (이후는 다음 날 타이머가 재기동)
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
User=seokhyeon
WorkingDirectory=/home/seokhyeon/QuantTrading
# .env 는 코드가 직접 읽는다 (EnvironmentFile 은 인라인 주석을 지원하지 않으므로 사용하지 않음)
# 실전 키 시세 조회는 k12 내에서만 (결정 11). 로컬 config 의 default_env(paper)를 --env real 로 덮어쓴다
# uv 는 절대 경로 (%h 치환자는 시스템 유닛에서 root 홈으로 풀릴 수 있어 사용하지 않음)
ExecStart=/home/seokhyeon/.local/bin/uv run --project /home/seokhyeon/QuantTrading python scripts/sweep_candles.py --env real
Restart=on-failure
RestartSec=5min
TimeoutStartSec=2h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qt-collector
